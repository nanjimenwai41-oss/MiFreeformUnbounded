<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- 帧 Provider 按真实调用 UID 校验，显式声明所需包的可见性。 -->
    <queries>
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
        <package android:name="com.android.systemui" />
        <package android:name="com.miui.aod" />
        <package android:name="com.miui.miwallpaper" />
        <package android:name="com.miui.miwallpaper.moon" />
        <package android:name="com.miui.miwallpaper.snowmountain" />
        <package android:name="com.miui.miwallpaper.geometry" />
        <package android:name="com.miui.miwallpaper.saturn" />
        <package android:name="com.miui.miwallpaper.earth" />
        <package android:name="com.miui.miwallpaper.mars" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".FreeformApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeformUnbounded">
        <provider
            android:name=".DepthFrameContentProvider"
            android:authorities="${applicationId}.depth-frames"
            android:exported="true"
            android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FreeformUnbounded">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
